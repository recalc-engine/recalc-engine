{
  "name": "recalc-engine",
  "version": "0.1.0",
  "description": "Headless, bug-for-bug Excel-compatible spreadsheet recalculation engine (Node addon).",
  "license": "Apache-2.0",
  "author": "pavelruzicka",
  "homepage": "https://github.com/recalc-engine/recalc-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recalc-engine/recalc-engine.git"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "formula",
    "recalculation"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "recalc-engine.*.node",
    "README.md"
  ],
  "napi": {
    "binaryName": "recalc-engine",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 10.16.0"
  },
  "scripts": {
    "build": "napi build --platform --release --features node",
    "build:debug": "napi build --platform --features node"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3"
  }
}
